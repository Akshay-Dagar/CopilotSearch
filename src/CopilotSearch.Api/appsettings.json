{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Connectors": { "Mode": "Mock" },
  "Llm": {
    "Provider": "Demo",
    "MaxIterations": 6,
    "Temperature": 0.1,
    "AzureOpenAI": {
      "Endpoint": "",
      "Deployment": "gpt-6-luna",
      "AuthMode": "ApiKey",
      "ApiKey": ""
    },
    "Claude": {
      "ResourceName": "",
      "Model": "claude-sonnet-5.5",
      "AuthMode": "ApiKey",
      "ApiKey": "",
      "MaxTokens": 4096
    }
  },
  "Orchestration": {
    "BudgetSeconds": 90,
    "MaxToolOutputChars": 32000,
    "MaxResultsCap": 25
  },
  "Tools": {
    "DefaultTimeoutSeconds": 30,
    "TimeoutSeconds": {
      "get_current_user": 10,
      "get_current_datetime": 5,
      "resolve_person": 10,
      "search_all": 10,
      "search_emails": 10,
      "get_email": 10,
      "search_teams_messages": 10,
      "get_file_content": 30,
      "search_files": 10,
      "search_copilot_chats": 30
    }
  }
}
